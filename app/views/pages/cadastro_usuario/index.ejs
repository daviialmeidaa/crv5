<!-- Content Area -->
        <div class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-50 dark:bg-steel-900 transition-colors duration-200 p-4 lg:p-6 md:p-8">
            <div class="max-w-2xl mx-auto bg-white dark:bg-steel-800 rounded-2xl shadow-sm border border-gray-100 dark:border-steel-700 overflow-hidden transition-colors">
                <!-- Header -->
                <div class="px-8 py-6 border-b border-gray-100 dark:border-steel-700 bg-gray-50 dark:bg-steel-800/50">
                    <h3 class="text-xl font-bold text-steel-800 dark:text-gray-100 tracking-tight">Novo Usuário</h3>
                    <p class="text-sm text-steel-500 dark:text-steel-400 mt-1">Preencha os dados abaixo para cadastrar um novo membro da equipe.</p>
                </div>

                <div class="p-8">
                    <form id="cadastroForm" class="space-y-6">
                        <!-- Campos -->
                        <div class="grid grid-cols-1 gap-6">
                            <div>
                                <label for="userName" class="block text-sm font-medium text-steel-700 dark:text-gray-300 mb-1.5">Nome Completo</label>
                                <input type="text" id="userName" required class="w-full px-4 py-2 2xl:py-2.5 bg-gray-50 dark:bg-steel-900 border border-gray-200 dark:border-steel-600 rounded-lg text-steel-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all shadow-sm">
                            </div>

                            <div>
                                <label for="userEmail" class="block text-sm font-medium text-steel-700 dark:text-gray-300 mb-1.5">Endereço de E-mail</label>
                                <input type="email" id="userEmail" required class="w-full px-4 py-2 2xl:py-2.5 bg-gray-50 dark:bg-steel-900 border border-gray-200 dark:border-steel-600 rounded-lg text-steel-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all shadow-sm">
                                <p class="text-xs text-steel-500 dark:text-steel-400 mt-2 flex items-center gap-1.5">
                                    <svg class="w-4 h-4 text-nexo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    Uma senha temporária será gerada e enviada automaticamente para este e-mail.
                                </p>
                            </div>

                            <div class="pt-2" id="adminToggleContainer">
                                <label class="block text-sm font-medium text-steel-700 dark:text-gray-300 mb-1.5">Perfil de Acesso</label>
                                <select id="userRole" required class="w-full px-4 py-2 2xl:py-2.5 bg-gray-50 dark:bg-steel-900 border border-gray-200 dark:border-steel-600 rounded-lg text-steel-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all shadow-sm">
                                    <option value="" disabled selected>Carregando perfis...</option>
                                </select>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="flex justify-end pt-4 border-t border-gray-100 dark:border-steel-700 mt-6">
                            <button type="submit" id="submitBtn" class="px-6 py-2.5 bg-nexo-600 hover:bg-nexo-700 text-white font-medium rounded-lg shadow-sm shadow-nexo-500/30 transition-all active:scale-95 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                                </svg>
                                Criar Usuário
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

