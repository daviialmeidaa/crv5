<script>
        
        document.addEventListener('DOMContentLoaded', () => {
            document.body.classList.remove('loading-auth');
        });
    </script>
    <!-- Alert Modal (Erros de Validação) -->
    <div id="alertModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-steel-900/40 dark:bg-black/60 backdrop-blur-sm transition-opacity"></div>
        <div class="bg-white dark:bg-steel-800 rounded-2xl shadow-xl w-full max-w-sm overflow-hidden z-10 transform scale-95 opacity-0 transition-all duration-300" id="alertModalContent">
            <div class="p-5 flex items-start gap-4">
                <div id="alertModalIconContainer" class="shrink-0 w-10 h-10 rounded-full bg-yellow-100 dark:bg-yellow-900/30 flex items-center justify-center text-yellow-600 dark:text-yellow-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <div>
                    <h3 id="alertModalTitle" class="text-sm font-semibold text-steel-900 dark:text-gray-100 mb-1">Atenção</h3>
                    <p class="text-xs text-steel-500 dark:text-steel-400 leading-relaxed" id="alertModalMessage">
                        Selecione um mês para atualizar os custos.
                    </p>
                </div>
            </div>
            <div class="px-5 py-3 bg-gray-50 dark:bg-steel-800/50 border-t border-gray-100 dark:border-steel-700/50 flex justify-end">
                <button type="button" onclick="CustosApp.closeAlertModal()" class="px-4 py-2 bg-steel-800 hover:bg-steel-700 dark:bg-steel-600 dark:hover:bg-steel-500 text-white rounded-lg text-xs font-medium transition-colors shadow-sm">
                    Entendido
                </button>
            </div>
        </div>
    </div>

    <!-- Sync Progress Modal -->
    <div id="syncModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-steel-900/60 dark:bg-black/80 backdrop-blur-md transition-opacity"></div>
        <div class="bg-white dark:bg-steel-800 rounded-2xl shadow-2xl w-full max-w-3xl overflow-hidden z-10 flex flex-col border border-steel-200 dark:border-steel-700 transform scale-95 opacity-0 transition-all duration-300" id="syncModalContent">
            <div class="p-6 text-center border-b border-steel-100 dark:border-steel-700/50">
                <div class="mx-auto w-16 h-16 rounded-full bg-nexo-50 dark:bg-nexo-900/20 flex items-center justify-center text-nexo-500 mb-4 shadow-inner" id="syncModalIcon">
                    <svg class="animate-spin h-8 w-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-steel-900 dark:text-gray-100" id="syncModalTitle">Sincronizando Custos...</h3>
                <p class="text-xs text-steel-500 dark:text-steel-400 mt-2" id="syncModalSubtitle">Não feche esta janela. O processo pode levar alguns instantes.</p>
            </div>

            <div class="p-0 bg-gray-50 dark:bg-steel-900/30 flex-1">
                <!-- Progress Bar Container -->
                <div class="px-6 pt-4 pb-2">
                    <div class="flex justify-between items-center mb-1.5">
                        <span class="text-xs font-medium text-steel-700 dark:text-steel-300">Progresso</span>
                        <span class="text-xs font-bold text-nexo-600 dark:text-nexo-400" id="syncProgressText">0%</span>
                    </div>
                    <div class="w-full bg-steel-200 dark:bg-steel-700 rounded-full h-2.5 overflow-hidden">
                        <div id="syncProgressBar" class="bg-nexo-500 h-2.5 rounded-full transition-all duration-300" ></div>
                    </div>
                </div>

                <div class="px-6 py-4">
                    <div id="syncLog" class="bg-[#0c0c0c] rounded-lg p-5 text-[13px] font-mono leading-relaxed text-green-400 shadow-inner h-56 overflow-y-auto custom-scrollbar border border-steel-800">
                        <div class="text-center opacity-50 italic mt-16 text-steel-500">Conectando ao terminal de processos...</div>
                    </div>
                </div>
            </div>

            <div class="p-4 bg-white dark:bg-steel-800 border-t border-steel-200 dark:border-steel-700/50 flex justify-end hidden" id="syncModalFooter">
                <button type="button" onclick="CustosApp.closeSyncModal()" class="px-5 py-2.5 bg-nexo-500 hover:bg-nexo-600 text-white rounded-lg text-sm font-medium transition-all shadow-sm shadow-nexo-500/20 hover:shadow-nexo-500/40">
                    Concluir e Atualizar Tela
                </button>
            </div>
        </div>
    </div>

    <!-- Email Modal -->
    <div id="emailModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-steel-900/60 dark:bg-black/80 backdrop-blur-md transition-opacity" onclick="CustosApp.closeEmailModal()"></div>
        <div class="bg-white dark:bg-steel-800 rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden z-10 flex flex-col border border-steel-200 dark:border-steel-700 transform scale-95 opacity-0 transition-all duration-300" id="emailModalContent">
            <div class="px-6 py-4 border-b border-steel-100 dark:border-steel-700 flex justify-between items-center">
                <h3 class="text-base font-bold text-steel-900 dark:text-gray-100 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-nexo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    Enviar Relatório para Contabilidade
                </h3>
                <button onclick="CustosApp.closeEmailModal()" class="text-steel-400 hover:text-steel-600 dark:hover:text-gray-300 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <form id="emailForm" onsubmit="CustosApp.submitEmailForm(event)" class="flex flex-col">
                <div class="p-6 space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-steel-600 dark:text-steel-400 mb-1">Para (Destinatários)</label>
                        <input type="text" id="emailTo" required placeholder="email@contabilidade.com.br, outro@email.com" class="w-full bg-gray-50 dark:bg-steel-900/50 border border-steel-200 dark:border-steel-700 text-steel-800 dark:text-gray-100 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-nexo-500 focus:ring-1 focus:ring-nexo-500 transition-colors">
                        <p class="text-[10px] text-steel-400 mt-1">Separe múltiplos e-mails com vírgula ou ponto-e-vírgula.</p>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-steel-600 dark:text-steel-400 mb-1">CC (Com Cópia)</label>
                        <input type="text" id="emailCc" placeholder="copia@nexomed.com.br" class="w-full bg-gray-50 dark:bg-steel-900/50 border border-steel-200 dark:border-steel-700 text-steel-800 dark:text-gray-100 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-nexo-500 focus:ring-1 focus:ring-nexo-500 transition-colors">
                    </div>
                    <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-3 border border-blue-100 dark:border-blue-800/30 flex items-start gap-3">
                        <svg class="w-5 h-5 text-blue-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <div class="text-xs text-blue-800 dark:text-blue-300">
                            <strong>Anexos automáticos:</strong><br>
                            1. Relatório em texto matricial com os totais do ano.<br>
                            2. Planilha Excel bruta filtrada pelo ano selecionado.
                        </div>
                    </div>
                </div>

                <div class="px-6 py-4 bg-gray-50 dark:bg-steel-900/30 border-t border-steel-200 dark:border-steel-700/50 flex justify-end gap-3">
                    <button type="button" onclick="CustosApp.closeEmailModal()" class="px-4 py-2 bg-white dark:bg-steel-800 border border-steel-200 dark:border-steel-600 text-steel-700 dark:text-gray-200 rounded-lg text-sm font-medium hover:bg-gray-50 dark:hover:bg-steel-700 transition-colors">
                        Cancelar
                    </button>
                    <button type="submit" id="btnSendEmail" class="px-5 py-2 bg-nexo-500 hover:bg-nexo-600 text-white rounded-lg text-sm font-medium transition-all shadow-sm flex items-center gap-2">
                        <span>Disparar E-mail</span>
                        <svg id="emailSpinner" class="animate-spin h-4 w-4 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <script src="/js/pages/custos_produtos/custos_produtos.js"></script>
