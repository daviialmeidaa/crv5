<!-- ========================================== -->
    <!-- Modal CRUD (Criar / Editar Item) -->
    <!-- ========================================== -->
    <div id="itemModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center">
        <div class="absolute inset-0 bg-steel-900/40 backdrop-blur-sm transition-opacity" onclick="IA.closeModal()"></div>

        <div class="bg-white dark:bg-steel-800 rounded-2xl shadow-2xl w-full max-w-5xl max-h-[92vh] flex flex-col relative z-10 mx-4 slide-in border border-gray-100 dark:border-steel-700">
            <!-- Header do Modal -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 dark:border-steel-700 bg-gray-50/50 dark:bg-steel-900/50 rounded-t-2xl">
                <h3 id="modalTitle" class="text-lg font-semibold text-steel-800 dark:text-gray-100 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-nexo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                    Novo Item Arrematado
                </h3>
                <button onclick="IA.closeModal()" class="text-steel-400 hover:text-red-500 dark:hover:text-red-400 transition-colors p-1 bg-white dark:bg-steel-700 hover:bg-red-50 dark:hover:bg-steel-600 rounded-lg border border-gray-200 dark:border-steel-600 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <!-- Body do Modal -->
            <div class="flex-1 overflow-y-auto p-4 lg:p-6 custom-scrollbar">
                <form id="itemForm" onsubmit="IA.saveItem(event)">
                    <input type="hidden" id="formChave" value="">

                    <!-- Seção: Identificação -->
                    <div class="mb-6">
                        <h4 class="text-sm font-semibold text-steel-800 dark:text-gray-100 mb-3 flex items-center gap-2">
                            <span class="w-1.5 h-4 bg-nexo-500 rounded-full"></span>
                            Identificação do Contrato
                        </h4>
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Participante</label>
                                <select id="formParticipante" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                                    <option value="NEXOMED">NEXOMED</option>
                                    <option value="BML HOSPITALAR">BML HOSPITALAR</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Cód. Contrato</label>
                                <input type="number" id="formCodContrato" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Cód. Contrato Concat</label>
                                <input type="text" id="formCodContratoConcat" readonly class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-gray-100 dark:bg-steel-900 rounded-lg text-steel-500 dark:text-steel-400 outline-none cursor-not-allowed">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Edital</label>
                                <input type="text" id="formEdital" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Tipo de Contrato</label>
                                <select id="formTipoContrato" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                                    <option value="">Selecione...</option>
                                    <option value="R. Vendas">R. Vendas</option>
                                    <option value="R. Consignado">R. Consignado</option>
                                    <option value="Estruturante">Estruturante</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Classificação</label>
                                <select id="formClassificacao" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                                    <option value="">Selecione...</option>
                                    <option value="OPME">OPME</option>
                                    <option value="Descartável">Descartável</option>
                                    <option value="Misto">Misto</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Data Pregão</label>
                                <input type="date" id="formDataPregao" class="custom-datepicker w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                            </div>
                        </div>
                    </div>

                    <!-- Seção: Localização -->
                    <div class="mb-6">
                        <h4 class="text-sm font-semibold text-steel-800 dark:text-gray-100 mb-3 flex items-center gap-2">
                            <span class="w-1.5 h-4 bg-nexo-500 rounded-full"></span>
                            Órgão e Localização
                        </h4>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="md:col-span-2">
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Órgão</label>
                                <input type="text" id="formOrgao" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">UF</label>
                                    <div class="relative w-full">
                                        <input type="text" id="formUF" autocomplete="off" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all uppercase cursor-pointer" readonly>
                                        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-steel-400">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                                        </div>
                                        <div id="ufDropdown" class="hidden absolute z-[100] w-full mt-1 bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 rounded-lg shadow-lg max-h-48 overflow-y-auto custom-scrollbar">
                                            <ul id="ufList" class="py-1 text-sm text-steel-700 dark:text-gray-200"></ul>
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Município</label>
                                    <div class="relative w-full">
                                        <input type="text" id="formMunicipio" autocomplete="off" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all uppercase">
                                        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-steel-400">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                                        </div>
                                        <div id="municipioDropdown" class="hidden absolute z-[100] w-full mt-1 bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 rounded-lg shadow-lg max-h-48 overflow-y-auto custom-scrollbar">
                                            <ul id="municipiosList" class="py-1 text-sm text-steel-700 dark:text-gray-200"></ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Seção: Prazos e Status -->
                    <div class="mb-6">
                        <h4 class="text-sm font-semibold text-steel-800 dark:text-gray-100 mb-3 flex items-center gap-2">
                            <span class="w-1.5 h-4 bg-nexo-500 rounded-full"></span>
                            Prazos e Status
                        </h4>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Data Proposta</label>
                                <input type="date" id="formDataProposta" class="custom-datepicker w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Código Status</label>
                                <select id="formCodStatus" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                                    <option value="">--</option>
                                    <option value="0">0</option>
                                    <option value="1">1</option>
                                    <option value="2">2</option>
                                    <option value="3">3</option>
                                    <option value="4">4</option>
                                    <option value="5">5</option>
                                    <option value="6">6</option>
                                    <option value="7">7</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Situação / Status</label>
                                <input type="text" id="formSituacaoStatus" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Vigência</label>
                                <input type="text" id="formVigencia" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Início</label>
                                <input type="date" id="formVigenciaInicio" class="custom-datepicker w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Término</label>
                                <input type="date" id="formVigenciaTermino" class="custom-datepicker w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Empenho</label>
                                <input type="date" id="formEmpenho" class="custom-datepicker w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Adjudicação</label>
                                <input type="date" id="formAdjudicacao" class="custom-datepicker w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                            </div>
                        </div>
                    </div>

                    <!-- Seção: Produtos -->
                    <div class="mb-6">
                        <div class="flex items-center justify-between mb-3 border-b border-gray-100 dark:border-steel-700 pb-1">
                            <h4 class="text-sm font-semibold text-steel-800 dark:text-gray-100 flex items-center gap-2">
                                <span class="w-1.5 h-4 bg-nexo-500 rounded-full"></span>
                                Produtos / Itens
                            </h4>
                            <button type="button" id="btnAddProduto" class="text-xs flex items-center gap-1 text-nexo-500 hover:text-nexo-600 font-medium bg-nexo-50 dark:bg-steel-700 px-2 py-1 rounded transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                  <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd" />
                                </svg>
                                Adicionar Produto
                            </button>
                        </div>
                        <div id="produtosContainer" class="space-y-4">
                            <!-- JS vai injetar os produtos aqui -->
                        </div>
                    </div>


                    <!-- Seção: Logística -->
                    <div class="mb-6">
                        <h4 class="text-sm font-semibold text-steel-800 dark:text-gray-100 mb-3 flex items-center gap-2">
                            <span class="w-1.5 h-4 bg-nexo-500 rounded-full"></span>
                            Logística e Observações
                        </h4>
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Instrumental</label>
                                <select id="formInstrumental" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                                    <option value="">--</option>
                                    <option value="SIM">SIM</option>
                                    <option value="NÃO">NÃO</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Instrumentador</label>
                                <select id="formInstrumentador" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                                    <option value="">--</option>
                                    <option value="SIM">SIM</option>
                                    <option value="NÃO">NÃO</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Local de Entrega</label>
                                <input type="text" id="formLocalEntrega" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Prazo de Entrega</label>
                                <input type="text" id="formPrazoEntrega" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all">
                            </div>
                        </div>
                        <div class="mt-4">
                            <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Detalhamento</label>
                            <textarea id="formDetalhamento" rows="3" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all resize-none"></textarea>
                        </div>
                        <div class="mt-4">
                            <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1">Descrição Database</label>
                            <textarea id="formDescricaoDatabase" rows="2" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-steel-600 bg-white dark:bg-steel-700 rounded-lg text-steel-800 dark:text-gray-200 outline-none focus:border-nexo-500 input-glow transition-all resize-none"></textarea>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Footer do Modal -->
            <div class="px-6 py-4 border-t border-gray-100 dark:border-steel-700 flex items-center justify-between bg-gray-50/50 dark:bg-steel-900/50 rounded-b-2xl">
                <button id="btnDeleteFromModal" onclick="IA.deleteFromModal()" class="hidden px-4 py-2 text-sm font-medium text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 hover:bg-red-100 dark:hover:bg-red-900/40 border border-red-200 dark:border-red-800/30 rounded-lg transition-colors">
                    Excluir Item
                </button>
                <div class="flex items-center gap-3 ml-auto">
                    <button onclick="IA.closeModal()" class="px-5 py-2 text-sm font-medium text-steel-600 dark:text-gray-300 bg-white dark:bg-steel-700 hover:bg-gray-50 dark:hover:bg-steel-600 border border-gray-200 dark:border-steel-600 rounded-lg transition-colors">
                        Cancelar
                    </button>
                    <button onclick="IA.saveItem()" class="px-5 py-2 text-sm font-medium text-white bg-nexo-600 hover:bg-nexo-700 rounded-lg transition-colors shadow-sm">
                        Salvar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- Modal de Confirmação de Exclusão -->
    <!-- ========================================== -->
    <div id="deleteModal" class="hidden fixed inset-0 z-[110] flex items-center justify-center">
        <div class="absolute inset-0 bg-steel-900/50 backdrop-blur-sm" onclick="IA.closeDeleteModal()"></div>
        <div class="bg-white dark:bg-steel-800 rounded-2xl shadow-2xl w-full max-w-md relative z-10 mx-4 slide-in border border-gray-100 dark:border-steel-700 p-4 lg:p-6 text-center">
            <div class="w-14 h-14 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            </div>
            <h3 class="text-lg font-semibold text-steel-800 dark:text-gray-100 mb-2">Confirmar Exclusão</h3>
            <p id="deleteModalText" class="text-sm text-steel-500 dark:text-steel-400 mb-6">Tem certeza que deseja excluir este item? Esta ação não pode ser desfeita.</p>
            <div class="flex gap-3 justify-center">
                <button onclick="IA.closeDeleteModal()" class="px-5 py-2 text-sm font-medium text-steel-600 dark:text-gray-300 bg-white dark:bg-steel-700 hover:bg-gray-50 dark:hover:bg-steel-600 border border-gray-200 dark:border-steel-600 rounded-lg transition-colors">Cancelar</button>
                <button onclick="IA.confirmDelete()" class="px-5 py-2 text-sm font-medium text-white bg-red-500 hover:bg-red-600 rounded-lg transition-colors shadow-sm">Excluir</button>
            </div>
        </div>
    </div>

    <!-- ========================================== -->



    <!-- Toast -->
    <div id="toast" class="toast bg-emerald-600 text-white"></div>

    <script>
        
        document.addEventListener('DOMContentLoaded', () => {
            document.body.classList.remove('loading-auth');
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    
    <script src="/js/components/datepicker.js"></script>
    
    <script src="/js/shared/cell_selector.js"></script>
    <script src="/js/pages/itens_arrematados/itens_arrematados.js"></script>
