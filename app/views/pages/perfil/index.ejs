<!-- Content Area -->
        <div class="flex-1 overflow-auto p-4 lg:p-6">
            <div class="max-w-3xl mx-auto bg-white dark:bg-steel-800 rounded-xl shadow-sm border border-gray-200 dark:border-steel-700 overflow-hidden">
                <div class="px-8 py-6 border-b border-gray-100 dark:border-steel-700 bg-gray-50 dark:bg-steel-800/50">
                    <h3 class="text-lg font-semibold text-steel-800 dark:text-gray-100">Informações Pessoais</h3>
                    <p class="text-sm text-steel-500 dark:text-steel-400 mt-1">Gerencie os detalhes do seu perfil e preferências de conta.</p>
                </div>

                <div class="p-8">
                    <form id="profileForm" class="space-y-6">
                        <!-- Avatar Section -->
                        <div class="flex items-center gap-6">
                            <div class="relative group cursor-pointer" onclick="document.getElementById('avatarUpload').click()">
                                <div id="profileAvatarDisplay" class="w-24 h-24 rounded-full bg-nexo-600 flex items-center justify-center text-3xl font-bold text-white shadow-md overflow-hidden">
                                    <span id="profileInitials">U</span>
                                </div>
                                <div class="absolute inset-0 bg-black/40 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </div>
                                <input type="file" id="avatarUpload" class="hidden" accept="image/*">
                            </div>
                            <div>
                                <h4 class="text-sm font-semibold text-steel-800 dark:text-gray-200">Foto de Perfil</h4>
                                <p class="text-xs text-steel-500 dark:text-steel-400 mt-1">JPG, GIF ou PNG. Máximo de 2MB.</p>
                                <button type="button" onclick="document.getElementById('avatarUpload').click()" class="mt-3 px-4 py-1.5 border border-gray-300 dark:border-steel-600 rounded-lg text-sm font-medium text-steel-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-steel-700 transition-colors">Alterar foto</button>
                            </div>
                        </div>

                        <hr class="border-gray-100 dark:border-steel-700">

                        <!-- Campos -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="col-span-1 md:col-span-2">
                                <label for="profileName" class="block text-sm font-medium text-steel-700 dark:text-gray-300 mb-1.5">Nome Completo</label>
                                <input type="text" id="profileName" class="w-full px-4 py-2 2xl:py-2.5 bg-gray-50 dark:bg-steel-900 border border-gray-200 dark:border-steel-600 rounded-lg text-steel-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all shadow-sm">
                            </div>

                            <div class="col-span-1 md:col-span-2">
                                <label for="profileEmail" class="block text-sm font-medium text-steel-700 dark:text-gray-300 mb-1.5">Endereço de E-mail</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <svg class="h-5 w-5 text-steel-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                                            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                                        </svg>
                                    </div>
                                    <input type="email" id="profileEmail" disabled class="w-full pl-10 px-4 py-2 2xl:py-2.5 bg-gray-100 dark:bg-steel-800 border border-gray-200 dark:border-steel-700 rounded-lg text-steel-500 dark:text-steel-400 cursor-not-allowed shadow-sm focus:outline-none">
                                </div>
                                <p class="text-xs text-steel-400 mt-1.5">Seu e-mail é sua chave de acesso e não pode ser alterado.</p>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="flex justify-end pt-4">
                            <button type="submit" class="px-6 py-2.5 bg-nexo-600 hover:bg-nexo-700 text-white font-medium rounded-lg shadow-sm shadow-nexo-500/30 transition-all active:scale-95 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                                Salvar Alterações
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Footer -->
