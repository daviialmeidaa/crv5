<!-- Content Area -->
        <div class="flex-1 p-4 lg:p-6 overflow-hidden flex flex-col">

            <!-- KPI Cards Row (Removido a pedido) -->
            <!-- Ferramentas e Filtros -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4 fade-in-up animation-delay-100"
                >
                <div class="flex items-center gap-2">
                    <!-- Tabs: Participante -->
                    <div class="flex bg-gray-100 dark:bg-steel-700 rounded-lg p-0.5">
                        <button id="tabNexomed" onclick="AL.switchTab('NEXOMED')"
                            class="px-4 py-1.5 text-xs font-semibold rounded-md transition-all bg-white dark:bg-steel-600 text-steel-800 dark:text-white shadow-sm">NEXOMED</button>
                        <button id="tabBml" onclick="AL.switchTab('BML')"
                            class="px-4 py-1.5 text-xs font-semibold rounded-md transition-all text-steel-500 dark:text-steel-400 hover:text-steel-700 dark:hover:text-gray-200">BML</button>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <%- include('../../components/data-grid/toolbar', { grid: {clearId: 'btnClearFilters'} }) %>
                    <button id="btnExport" onclick="AL.exportXLS()"
                        class="px-4 py-2 flex items-center gap-2 bg-white dark:bg-steel-800 text-steel-700 dark:text-gray-200 border border-gray-200 dark:border-steel-600 rounded-lg text-sm font-medium hover:bg-gray-50 dark:hover:bg-steel-700 transition-colors shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        Exportar
                    </button>
                    <button id="btnNovoItem" onclick="AL.openModal()"
                        class="px-4 py-2 flex items-center gap-2 bg-nexo-600 text-white rounded-lg text-sm font-medium hover:bg-nexo-700 transition-colors shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                        </svg>
                        Nova Agenda
                    </button>
                </div>
            </div>

            <!-- Tabela -->
            <div class="bg-white dark:bg-steel-800 rounded-xl border border-gray-200 dark:border-steel-700 shadow-sm flex-1 flex flex-col overflow-hidden relative fade-in-up animation-delay-150"
                >

                <!-- Loading overlay -->
                <div id="tableLoading"
                    class="absolute inset-0 bg-white/80 dark:bg-steel-800/80 backdrop-blur-sm z-30 flex flex-col items-center justify-center rounded-xl">
                    <svg class="animate-spin h-8 w-8 text-nexo-500 mb-3" xmlns="http://www.w3.org/2000/svg" fill="none"
                        viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
                        </circle>
                        <path class="opacity-75" fill="currentColor"
                            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                        </path>
                    </svg>
                    <p class="text-sm text-steel-500 dark:text-steel-400">Carregando agenda de licitações...</p>
                </div>

                <!-- Container com overflow -->
                <%- include('../../components/data-grid/grid', { grid: {"bodyId": "alTableBody", "headerId": "alTableHeader", "pageSizeId": "itemsPerPage", "infoId": "paginationInfo", "paginationId": "paginationControls", "clearId": "btnClearFilters"} }) %>
            </div>

        </div>

