<!-- ========================================== -->
    <!-- Modal CRUD (Criar / Editar Item) -->
    <!-- ========================================== -->
    <div id="itemModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center">
        <div class="absolute inset-0 bg-steel-900/40 backdrop-blur-sm transition-opacity" onclick="AL.closeModal()">
        </div>

        <div
            class="bg-white dark:bg-steel-800 rounded-2xl shadow-2xl w-full max-w-5xl max-h-[92vh] flex flex-col relative z-10 mx-4 slide-in border border-gray-100 dark:border-steel-700">
            <!-- Header do Modal -->
            <div
                class="flex items-center justify-between px-6 py-4 border-b border-gray-100 dark:border-steel-700 bg-gray-50/50 dark:bg-steel-900/50 rounded-t-2xl">
                <h3 id="modalTitle"
                    class="text-lg font-semibold text-steel-800 dark:text-gray-100 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-nexo-500" fill="none"
                        viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                    Nova Agenda
                </h3>
                <button onclick="AL.closeModal()"
                    class="text-steel-400 hover:text-red-500 dark:hover:text-red-400 transition-colors p-1 bg-white dark:bg-steel-700 hover:bg-red-50 dark:hover:bg-steel-600 rounded-lg border border-gray-200 dark:border-steel-600 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Body do Modal -->
            <div class="flex-1 overflow-y-auto">
                <form id="itemForm" onsubmit="AL.saveItem(event)" class="p-6 space-y-6">

                    <!-- 1. Cabeçalho / Empresa -->
                    <div
                        class="bg-gray-50 dark:bg-steel-900/30 p-4 rounded-xl border border-gray-100 dark:border-steel-700/50">
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                            <div>
                                <label
                                    class="block text-xs font-semibold text-steel-700 dark:text-gray-300 mb-1.5 uppercase tracking-wider">Empresa
                                    Participante <span class="text-red-500">*</span></label>
                                <select id="formEmpresa" required
                                    class="w-full bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 text-steel-800 dark:text-white text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all input-glow shadow-sm">
                                    <option value="NEXOMED">NEXOMED</option>
                                    <option value="BML">BML</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Identificação do Pregão -->
                    <div>
                        <h4
                            class="text-sm font-semibold text-steel-800 dark:text-gray-100 mb-3 flex items-center gap-2">
                            <span class="w-1.5 h-4 bg-nexo-500 rounded-full"></span>
                            Identificação do Pregão
                        </h4>
                        <div class="flex flex-col gap-4">
                            <!-- Linha 1: Órgão (75%) e UF (25%) -->
                            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                                <div class="md:col-span-3">
                                    <label
                                        class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1.5">Órgão/Instituição</label>
                                    <input type="text" id="formOrgao"
                                        class="w-full bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 text-steel-800 dark:text-white text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all input-glow shadow-sm">
                                </div>
                                <div class="md:col-span-1">
                                    <label
                                        class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1.5">UF</label>
                                    <div class="relative w-full">
                                        <input type="text" id="formUF" autocomplete="off" class="w-full bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 text-steel-800 dark:text-white text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all input-glow shadow-sm cursor-pointer" readonly placeholder="-- Selecione --">
                                        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-steel-400">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                                        </div>
                                        <div id="ufDropdown" class="hidden absolute z-[100] w-full mt-1 bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 rounded-lg shadow-lg max-h-48 overflow-y-auto custom-scrollbar">
                                            <ul id="ufList" class="py-1 text-sm text-steel-700 dark:text-gray-200"></ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Linha 2: Pregão (50%) e Modalidade (50%) -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label
                                        class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1.5">Nº
                                        do Pregão</label>
                                    <input type="text" id="formPregao"
                                        class="w-full bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 text-steel-800 dark:text-white text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all input-glow shadow-sm">
                                </div>
                                <div>
                                    <label
                                        class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1.5">Modalidade</label>
                                    <div class="relative w-full">
                                        <input type="text" id="formModalidade" autocomplete="off" class="w-full bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 text-steel-800 dark:text-white text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all input-glow shadow-sm cursor-pointer" readonly placeholder="-- Selecione --">
                                        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-steel-400">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                                        </div>
                                        <div id="modalidadeDropdown" class="hidden absolute z-[100] w-full mt-1 bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 rounded-lg shadow-lg max-h-48 overflow-y-auto custom-scrollbar">
                                            <ul id="modalidadeList" class="py-1 text-sm text-steel-700 dark:text-gray-200"></ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Objeto e Plataforma -->
                    <div>
                        <h4
                            class="text-sm font-semibold text-steel-800 dark:text-gray-100 mb-3 flex items-center gap-2">
                            <span class="w-1.5 h-4 bg-nexo-500 rounded-full"></span>
                            Objeto e Plataforma
                        </h4>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                            <div>
                                <label
                                    class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1.5">Categoria/Classe
                                    do Material</label>
                                <div class="relative w-full">
                                    <input type="text" id="formCategoria" autocomplete="off" class="w-full bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 text-steel-800 dark:text-white text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all input-glow shadow-sm cursor-pointer" readonly placeholder="-- Selecione --">
                                    <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-steel-400">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                                    </div>
                                    <div id="categoriaDropdown" class="hidden absolute z-[100] w-full mt-1 bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 rounded-lg shadow-lg max-h-48 overflow-y-auto custom-scrollbar">
                                        <ul id="categoriaList" class="py-1 text-sm text-steel-700 dark:text-gray-200"></ul>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label
                                    class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1.5">Portal/Plataforma
                                    do Pregão</label>
                                <div class="relative w-full">
                                    <input type="text" id="formPortal" autocomplete="off" class="w-full bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 text-steel-800 dark:text-white text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all input-glow shadow-sm cursor-pointer" readonly placeholder="-- Selecione --">
                                    <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-steel-400">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                                    </div>
                                    <div id="portalDropdown" class="hidden absolute z-[100] w-full mt-1 bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 rounded-lg shadow-lg max-h-48 overflow-y-auto custom-scrollbar">
                                        <ul id="portalList" class="py-1 text-sm text-steel-700 dark:text-gray-200"></ul>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label
                                    class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1.5">Objeto/Especialidade</label>
                                <input type="text" id="formObjeto"
                                    class="w-full bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 text-steel-800 dark:text-white text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all input-glow shadow-sm">
                            </div>
                        </div>
                        <div class="grid grid-cols-1 gap-4">
                            <div>
                                <label
                                    class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1.5">Observações/Status</label>
                                <textarea id="formObservacoes" rows="2"
                                    class="w-full bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 text-steel-800 dark:text-white text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all input-glow shadow-sm resize-none"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Prazos e Datas -->
                    <div>
                        <h4
                            class="text-sm font-semibold text-steel-800 dark:text-gray-100 mb-3 flex items-center gap-2">
                            <span class="w-1.5 h-4 bg-nexo-500 rounded-full"></span>
                            Prazos e Datas
                        </h4>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-4">
                            <div class="lg:col-span-1">
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1.5">Data
                                    Cad. Proposta</label>
                                <input type="date" id="formDataCadastro"
                                    class="custom-datepicker w-full bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 text-steel-800 dark:text-white text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all input-glow shadow-sm">
                            </div>
                            <div class="lg:col-span-1">
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1.5">Data
                                    Limite Proposta</label>
                                <input type="date" id="formDataLimite"
                                    class="custom-datepicker w-full bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 text-steel-800 dark:text-white text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all input-glow shadow-sm">
                            </div>
                            <div class="lg:col-span-1">
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1.5">Hora
                                    Limite</label>
                                <input type="time" id="formHoraLimite"
                                    class="custom-timepicker w-full bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 text-steel-800 dark:text-white text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all input-glow shadow-sm">
                            </div>
                            <div class="lg:col-span-1">
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1.5">Data
                                    dos Lances</label>
                                <input type="date" id="formDataLances"
                                    class="custom-datepicker w-full bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 text-steel-800 dark:text-white text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all input-glow shadow-sm">
                            </div>
                            <div class="lg:col-span-1">
                                <label class="block text-xs font-medium text-steel-600 dark:text-steel-400 mb-1.5">Hora
                                    dos Lances</label>
                                <input type="time" id="formHoraLances"
                                    class="custom-timepicker w-full bg-white dark:bg-steel-800 border border-gray-200 dark:border-steel-600 text-steel-800 dark:text-white text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all input-glow shadow-sm">
                            </div>
                            <div class="lg:col-span-1">
                                <label
                                    class="block text-[11px] font-medium text-steel-600 dark:text-steel-400 mb-1.5 truncate"
                                    title="Antecedência do Cadastro (Dia Útil)">Antecedência (Dias)</label>
                                <input type="number" id="formAntecedencia" readonly tabindex="-1"
                                    class="w-full bg-gray-100 dark:bg-steel-900/50 border border-gray-200 dark:border-steel-700 text-steel-800 dark:text-white text-sm rounded-lg px-3 py-2 outline-none shadow-inner opacity-80 cursor-not-allowed text-center font-semibold">
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Footer do Modal -->
            <div
                class="px-6 py-4 border-t border-gray-100 dark:border-steel-700 flex items-center justify-between bg-gray-50/50 dark:bg-steel-900/50 rounded-b-2xl">
                <button id="btnDeleteFromModal" onclick="AL.deleteFromModal()"
                    class="hidden px-4 py-2 text-sm font-medium text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 hover:bg-red-100 dark:hover:bg-red-900/40 border border-red-200 dark:border-red-800/30 rounded-lg transition-colors">
                    Excluir Item
                </button>
                <div class="flex items-center gap-3 ml-auto">
                    <button onclick="AL.closeModal()"
                        class="px-5 py-2 text-sm font-medium text-steel-600 dark:text-gray-300 bg-white dark:bg-steel-700 hover:bg-gray-50 dark:hover:bg-steel-600 border border-gray-200 dark:border-steel-600 rounded-lg transition-colors">
                        Cancelar
                    </button>
                    <button onclick="AL.saveItem()"
                        class="px-5 py-2 text-sm font-medium text-white bg-nexo-600 hover:bg-nexo-700 rounded-lg transition-colors shadow-sm">
                        Salvar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- Modal de Confirmação de Exclusão -->
    <!-- ========================================== -->
    <div id="deleteModal" class="hidden fixed inset-0 z-[110] flex items-center justify-center">
        <div class="absolute inset-0 bg-steel-900/50 backdrop-blur-sm" onclick="AL.closeDeleteModal()"></div>
        <div
            class="bg-white dark:bg-steel-800 rounded-2xl shadow-2xl w-full max-w-md relative z-10 mx-4 slide-in border border-gray-100 dark:border-steel-700 p-4 lg:p-6 text-center">
            <div
                class="w-14 h-14 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                    stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
            </div>
            <h3 class="text-lg font-semibold text-steel-800 dark:text-gray-100 mb-2">Confirmar Exclusão</h3>
            <p id="deleteModalText" class="text-sm text-steel-500 dark:text-steel-400 mb-6">Tem certeza que deseja
                excluir este item? Esta ação não pode ser desfeita.</p>
            <div class="flex gap-3 justify-center">
                <button onclick="AL.closeDeleteModal()"
                    class="px-5 py-2 text-sm font-medium text-steel-600 dark:text-gray-300 bg-white dark:bg-steel-700 hover:bg-gray-50 dark:hover:bg-steel-600 border border-gray-200 dark:border-steel-600 rounded-lg transition-colors">Cancelar</button>
                <button onclick="AL.confirmDelete()"
                    class="px-5 py-2 text-sm font-medium text-white bg-red-500 hover:bg-red-600 rounded-lg transition-colors shadow-sm">Excluir</button>
            </div>
        </div>
    </div>

    <!-- ========================================== -->



    <!-- Toast -->
    <div id="toast" class="toast bg-emerald-600 text-white"></div>

    <script>
        
        document.addEventListener('DOMContentLoaded', () => {
            document.body.classList.remove('loading-auth');
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    
    
    <script src="/js/components/datepicker.js"></script>
    <script src="/js/components/timepicker.js"></script>
    <script src="/js/shared/cell_selector.js"></script>
    <script src="/js/pages/agenda_licitacoes/agenda_licitacoes.js"></script>
