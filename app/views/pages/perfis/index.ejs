<!-- Content Area -->
        <div class="flex-1 flex overflow-hidden bg-gray-50 dark:bg-steel-900 transition-colors duration-200 h-[calc(100vh-4rem)]">
            <!-- Left Side: List of Profiles -->

            <div class="w-1/3 min-w-[300px] max-w-[400px] border-r border-gray-200 dark:border-steel-700 bg-white dark:bg-steel-800 flex flex-col">
                <div class="p-5 border-b border-gray-200 dark:border-steel-700 flex justify-between items-center">
                    <h2 class="text-lg font-semibold">Perfis Cadastrados</h2>
                    <button onclick="PerfisModule.createNew()" class="p-1.5 bg-nexo-50 text-nexo-600 dark:bg-nexo-500/10 dark:text-nexo-400 rounded-md hover:bg-nexo-100 dark:hover:bg-nexo-500/20 transition-colors" title="Novo Perfil">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    </button>
                </div>
                <div class="flex-1 overflow-y-auto custom-scrollbar p-3 flex flex-col gap-2" id="rolesListContainer">
                    <!-- Roles will be rendered here -->
                </div>
            </div>

            <!-- Right Side: Editor -->
            <div class="flex-1 flex flex-col bg-gray-50 dark:bg-steel-900 overflow-y-auto custom-scrollbar p-4 lg:p-6 relative">

                <div id="editorEmptyState" class="absolute inset-0 flex flex-col items-center justify-center text-steel-400 dark:text-steel-500 transition-opacity duration-300">
                    <svg class="w-16 h-16 mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    <p>Selecione um perfil na lista ou crie um novo.</p>
                </div>

                <div id="editorContainer" class="hidden relative max-w-3xl w-full mx-auto bg-white dark:bg-steel-800 rounded-xl shadow-sm border border-gray-200 dark:border-steel-700 p-4 lg:p-6 opacity-0 transition-opacity duration-300">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold" id="editorTitle">Editar Perfil</h2>
                        <span id="systemBadge" class="hidden px-2.5 py-1 rounded-md text-xs font-medium bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 border border-blue-200 dark:border-blue-800/50">Nativo do Sistema</span>
                    </div>

                    <form id="roleForm" onsubmit="event.preventDefault(); PerfisModule.saveRole();">
                        <div class="mb-6">
                            <label class="block text-sm font-medium text-steel-700 dark:text-gray-300 mb-1.5">Nome do Perfil</label>
                            <input type="text" id="formRoleName" required class="w-full bg-gray-50 dark:bg-steel-900 border border-gray-300 dark:border-steel-600 text-steel-800 dark:text-white text-sm rounded-lg px-4 py-2 2xl:py-2.5 outline-none focus:ring-2 focus:ring-nexo-500/20 focus:border-nexo-500 transition-all uppercase" placeholder="EX: FINANCEIRO_JUNIOR">
                            <p class="mt-1 text-xs text-steel-500">Use nomes curtos sem espaços.</p>
                        </div>

                        <div class="mb-6">
                            <label class="block text-sm font-medium text-steel-700 dark:text-gray-300 mb-3">Atribuição de Permissões</label>

                            <!-- Dual Listbox -->
                            <div class="flex gap-4 items-stretch h-64">
                                <!-- Available -->
                                <div class="flex-1 flex flex-col border border-gray-200 dark:border-steel-700 rounded-lg overflow-hidden bg-gray-50 dark:bg-steel-900/50">
                                    <div class="bg-gray-100 dark:bg-steel-700 px-3 py-2 text-xs font-semibold text-center border-b border-gray-200 dark:border-steel-600 text-steel-600 dark:text-steel-300">Disponíveis</div>
                                    <div class="flex-1 p-2 overflow-y-auto custom-scrollbar flex flex-col gap-1" id="boxAvailable">
                                        <!-- Items -->
                                    </div>
                                </div>

                                <!-- Controls -->
                                <div class="flex flex-col justify-center gap-2">
                                    <button type="button" onclick="PerfisModule.moveItem('right')" class="p-2 bg-gray-200 dark:bg-steel-700 hover:bg-nexo-500 hover:text-white dark:hover:bg-nexo-600 text-steel-600 dark:text-gray-300 rounded-md transition-colors shadow-sm disabled:opacity-50">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                    </button>
                                    <button type="button" onclick="PerfisModule.moveItem('left')" class="p-2 bg-gray-200 dark:bg-steel-700 hover:bg-nexo-500 hover:text-white dark:hover:bg-nexo-600 text-steel-600 dark:text-gray-300 rounded-md transition-colors shadow-sm disabled:opacity-50">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                                    </button>
                                </div>

                                <!-- Selected -->
                                <div class="flex-1 flex flex-col border border-nexo-200 dark:border-nexo-900/50 rounded-lg overflow-hidden bg-nexo-50/30 dark:bg-nexo-900/10 shadow-inner">
                                    <div class="bg-nexo-100 dark:bg-nexo-900/40 px-3 py-2 text-xs font-semibold text-center border-b border-nexo-200 dark:border-nexo-800 text-nexo-700 dark:text-nexo-300">Atribuídas</div>
                                    <div class="flex-1 p-2 overflow-y-auto custom-scrollbar flex flex-col gap-1" id="boxSelected">
                                        <!-- Items -->
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="flex justify-end gap-3 pt-4 border-t border-gray-100 dark:border-steel-700 mt-6">
                            <button type="button" onclick="PerfisModule.promptDeleteRole()" id="btnDeleteRole" class="hidden px-4 py-2 text-sm font-medium text-red-600 bg-red-50 hover:bg-red-100 dark:bg-red-900/20 dark:hover:bg-red-900/40 rounded-lg transition-colors focus:outline-none">
                                Excluir Perfil
                            </button>
                            <button type="submit" id="btnSaveRole" class="px-5 py-2 text-sm font-medium text-white bg-nexo-600 hover:bg-nexo-700 rounded-lg transition-colors focus:outline-none shadow-sm flex items-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                Salvar Perfil
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>

        <!-- Footer -->
