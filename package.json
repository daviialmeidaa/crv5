{
  "name": "contas_a_receber_v5",
  "version": "1.0.0",
  "description": "",
  "main": "app/server.js",
  "scripts": {
    "dev": "nodemon --signal SIGTERM --ext js,json,py --ignore .venv/ scripts/start_hub.js",
    "start": "node scripts/start_hub.js",
    "start:node": "node app/server.js",
    "scheduler:agenda": "node app/scripts/run_cron_agenda_standalone.js",
    "scheduler:cobranca": "node app/scripts/run_cron_cobranca_standalone.js",
    "scheduler:agenda:friday": "node app/scripts/run_cron_agenda_friday.js",
    "postinstall": "node scripts/patch-node-sped-pdf.js",
    "patch-pdf": "node scripts/patch-node-sped-pdf.js",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:api": ".venv/bin/python -m pytest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report playwright-report/e2e",
    "test:staging": "playwright test -c playwright.staging.config.cjs",
    "test:staging:report": "playwright show-report playwright-report/staging"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.0",
    "nfe-danfe-pdf": "^1.0.3",
    "node-cron": "^4.6.0",
    "node-sped-pdf": "^1.0.66",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "redis": "^6.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "nodemon": "^3.1.14"
  }
}
